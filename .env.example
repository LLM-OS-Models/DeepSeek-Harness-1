# Harness-1 Local — 환경 변수 템플릿
#
# 복사해서 .env.local 로 두고 EXAMPLE 값을 실제 값으로 교체.
# launch_rl.sh / launch_sft.sh 가 .env.local 을 자동 source.
# 일부 값은 필수 (없으면 학습이 안 됨), 나머지는 옵션 (사용하는 도구에 따라).

# ===== 필수 =====

# 검색 임베딩 (text-embedding-3-large) 및 claim 검증용 LLM.
OPENAI_API_KEY="EXAMPLE"

# 검색 백엔드 (Chroma Cloud). 설정은 datagen/README.md 참조.
CHROMA_API_KEY="EXAMPLE"
CHROMA_DATABASE="EXAMPLE"

# ===== 모델 / GPU 토폴로지 (다른 PC 재현 시 자주 수정) =====

# 모델 경로. 기본은 HF hub id. 로컬 snapshot 절대경로도 받음.
# encoding.py 가 자동으로 모델 config + encoding_dsv4.py 를 찾는다.
#HARNESS1_MODEL_PATH="deepseek-ai/DeepSeek-V4-Flash-0731"
#HARNESS1_MODEL_PATH="/data/models/dsv4-flash-0731"

# HF 캐시 위치. 모델 가중치 157 GB 가 여기 들어감.
#HF_HOME="/data/huggingface"

# GPU 토폴로지. H100 80GB 는 32K–65K, H200 은 131K.
#ROLLOUT_TP_SIZE="8"
#ROLLOUT_MAX_MODEL_LEN="32768"
#ROLLOUT_GPU_MEM_UTIL="0.92"

# ===== 옵션 (사용 도구에 따라) =====

# 모델이 인증을 필요로 할 때만 (DeepSeek-V4-Flash 는 공개라 불필요).
HUGGINGFACE_TOKEN="EXAMPLE"

# BrowseComp+ 데이터셋 경로 (로컬 JSON). datagen/README.md 의 과정을 따른 경우.
BROWSECOMPPLUS_QRELS_GOLD_PATH="EXAMPLE"
BROWSECOMPPLUS_QRELS_EVIDENCE_PATH="EXAMPLE"
BROWSECOMPPLUS_QUERIES_PATH="EXAMPLE"
BROWSECOMPPLUS_ANSWERS_PATH="EXAMPLE"

# Reranker / 보조 검색 도구. ANTHROPIC_API_KEY 는 claim 검증 LLM용.
ANTHROPIC_API_KEY="EXAMPLE"
MOONSHOT_API_KEY="EXAMPLE"
BASETEN_API_KEY="EXAMPLE"
BASETEN_MODEL_URL="EXAMPLE"
JINA_API_KEY="EXAMPLE"
CONTEXTUAL_API_KEY="EXAMPLE"

# ===== 로깅 =====
# WANDB_API_KEY 와 RUN_NAME, OUTPUT_DIR 등은 launch_rl.sh 의 환경에서 세팅.
